# Every environment variable Watchdog reads, mirroring the Configuration page in Knowledge
# (docs/watchdog/architecture/configuration.md). Web and worker read them from their process
# environment and refuse to start when one is invalid. An empty value counts as unset.
# Nothing here is a real secret.

# self-hosted (default) or hosted. See the Mode table on the Configuration page.
WATCHDOG_MODE=self-hosted

# Postgres connection, which pg-boss also uses. Required.
DATABASE_URL=postgres://watchdog:watchdog@localhost:5432/watchdog

# Signs sessions and Digest unsubscribe links, so changing it breaks the links already sent.
# Required, at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The public base URL. Magic links, OAuth callbacks and the links in alerts, Digests,
# confirmation mails and unsubscribe headers are built on it. Required.
BETTER_AUTH_URL=http://localhost:3000

# Encrypts secrets at rest. Required, exactly 32 bytes in base64. This placeholder is public, so
# replace it before storing a secret: it logs a warning at boot, and hosted mode refuses it.
# Changing the key later makes stored secrets unreadable, so keep a copy.
# Generate one with: openssl rand -base64 32
WATCHDOG_ENCRYPTION_KEY=cmVwbGFjZS13aXRoLTMyLXJhbmRvbS1rZXktYnl0ZXM=

# Outgoing mail on port 587. Required in hosted mode. On self-hosted, leave them all empty and
# magic links are printed to the log. Set all of HOST, USER, PASSWORD and FROM, or none.
# SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The sender of alert, Digest, Destination confirmation and email cap notice mail. Defaults to
# SMTP_FROM. Hosted sets it to its alert subdomain, so alert mail and sign-in mail have separate
# senders.
SMTP_ALERT_FROM=

# OAuth sign-in. A provider is on when both its ID and its secret are set.
# GitHub sign-in also gives GitHub Sources their token.
# Register these callback URLs with the provider, built on BETTER_AUTH_URL:
#   Google: <BETTER_AUTH_URL>/api/auth/callback/google (an authorized redirect URI)
#   GitHub: <BETTER_AUTH_URL>/api/auth/callback/github (the OAuth app's callback URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The Telegram bot, for Telegram Destinations and, from M4, intake. Written <digits>:<token>, as
# BotFather gives it. Hosted sets the operator's shared bot, self-hosted one made with BotFather.
# Without it, Telegram Destinations are unavailable, as magic-link mail is without SMTP. Optional.
TELEGRAM_BOT_TOKEN=
# MTProto user sessions, from an app registered at my.telegram.org. Self-hosted only, optional.
# Set both or neither. Hosted ignores them and warns at boot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Reaching Obscura on the internal network. compose.yaml sets the URL (and DATABASE_URL) to its
# own containers. Obscura refuses to start without a token of at least 32 characters.
# Generate one with: openssl rand -hex 32
OBSCURA_CDP_URL=
OBSCURA_CDP_TOKEN=replace-with-at-least-32-random-characters

# The Chromium fallback renderer, an optional service on the chromium Compose profile. To use it,
# set both (the URL is ws://chromium:3000 in Compose) and run: docker compose --profile chromium up
# The worker sends the token as a Bearer header, and the service refuses any connection without it.
# At least 32 characters. Set both or neither. Without them, the chromium render mode is unavailable.
# Generate one with: openssl rand -hex 32
CHROMIUM_URL=
CHROMIUM_TOKEN=

# Private addresses the egress guard lets through, e.g. a local Ollama. Self-hosted, optional.
# Comma-separated hosts, IP addresses and CIDRs: ollama.local,192.168.1.0/24
# Hosted ignores it and warns at boot.
EGRESS_ALLOWLIST=

# Error tracking. Hosted only.
GLITCHTIP_DSN=
