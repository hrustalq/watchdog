# Every environment variable Watchdog reads, mirroring the Configuration page in Knowledge
# (docs/watchdog/architecture/configuration.md). Web and worker read them from their process
# environment and refuse to start when one is invalid. An empty value counts as unset.
# Nothing here is a real secret.

# self-hosted (default) or hosted. See the Mode table on the Configuration page.
WATCHDOG_MODE=self-hosted

# Postgres connection, which pg-boss also uses. Required.
DATABASE_URL=postgres://watchdog:watchdog@localhost:5432/watchdog

# Signs sessions. Required, at least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# The public base URL. Magic links and OAuth callbacks are built on it. Required.
BETTER_AUTH_URL=http://localhost:3000

# Encrypts secrets at rest. Required once Watchdog stores its first secret.
WATCHDOG_ENCRYPTION_KEY=

# Outgoing mail on port 587. Required in hosted mode. On self-hosted, leave them all empty and
# magic links are printed to the log. Set all of HOST, USER, PASSWORD and FROM, or none.
# SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth sign-in. A provider is on when both its ID and its secret are set.
# GitHub sign-in also gives GitHub Sources their token.
# Register these callback URLs with the provider, built on BETTER_AUTH_URL:
#   Google: <BETTER_AUTH_URL>/api/auth/callback/google (an authorized redirect URI)
#   GitHub: <BETTER_AUTH_URL>/api/auth/callback/github (the OAuth app's callback URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The Telegram bot, for intake and alerts. Optional.
TELEGRAM_BOT_TOKEN=
# MTProto user sessions. Self-hosted only, optional.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Reaching Obscura on the internal network. compose.yaml sets the URL (and DATABASE_URL) to its
# own containers. Obscura refuses to start without a token of at least 32 characters.
# Generate one with: openssl rand -hex 32
OBSCURA_CDP_URL=
OBSCURA_CDP_TOKEN=replace-with-at-least-32-random-characters

# Private addresses the egress guard lets through, e.g. a local Ollama. Self-hosted, optional.
EGRESS_ALLOWLIST=

# Error tracking. Hosted only.
GLITCHTIP_DSN=
