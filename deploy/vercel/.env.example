# The worker half of the temporary Vercel deployment (deploy/vercel/README.md).
# Copy this file to .env next to it, fill in the values, and never commit the copy.
#
# The web app on Vercel and this worker use the same database and secrets. Only DATABASE_URL
# differs: web takes Supabase's transaction pooler (port 6543), the worker takes the session
# pooler (port 5432), which pg-boss needs for a session-pinned connection.

WATCHDOG_MODE=self-hosted

DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require
# Copy the host from Supabase's Connect dialog; the aws-0/aws-1 prefix varies by region. If the
# password holds @ : / ? # or %, percent-encode it in the URL.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The final https://<project>.vercel.app address, or your custom domain.
BETTER_AUTH_URL=
# openssl rand -base64 32 (exactly 32 bytes, standard base64)
WATCHDOG_ENCRYPTION_KEY=

OBSCURA_CDP_URL=ws://obscura:9222
# openssl rand -hex 32
OBSCURA_CDP_TOKEN=

# Optional. Set all four to send magic links, alerts and Digests by mail; leave them empty and a
# self-hosted web prints magic links to its log instead. SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALERT_FROM=

# Optional. Telegram Destinations and intake.
TELEGRAM_BOT_TOKEN=
# Optional. MTProto user sessions (self-hosted only).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional. Private addresses the egress guard may reach from this machine.
EGRESS_ALLOWLIST=
