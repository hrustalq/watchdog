# Paste these into Vercel → Project → Settings → Environment Variables (all environments except
# Development). Never commit a filled copy. deploy/vercel/README.md walks through each one.

WATCHDOG_MODE=self-hosted

# Supabase's transaction-mode pooler (port 6543): each function instance opens a few short-lived
# connections. The worker uses the session pooler on port 5432 instead (deploy/vercel/.env).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
# Copy the host from Supabase's Connect dialog; the aws-0/aws-1 prefix varies by region. If the
# password holds @ : / ? # or %, percent-encode it in the URL.

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The final https://<project>.vercel.app address, or your custom domain.
BETTER_AUTH_URL=
# openssl rand -base64 32 (exactly 32 bytes, standard base64)
WATCHDOG_ENCRYPTION_KEY=

# Web never connects to Obscura. It reads these only to know a renderer exists, so the Sources form
# offers rendered pages; the worker runs Obscura in deploy/vercel/compose.yaml.
OBSCURA_CDP_URL=ws://obscura:9222
OBSCURA_CDP_TOKEN=

# Optional. Without SMTP, magic links are printed to the Vercel function log.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALERT_FROM=

# Optional.
TELEGRAM_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
