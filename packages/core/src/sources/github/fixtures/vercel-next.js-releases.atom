    <title>v16.5.0-canary.45</title>
    <content type="html">&lt;h3&gt;Core Changes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;docs: clarify agent feedback workspace context: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;6265069144&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/101358&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/101358/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/101358&quot;&gt;#101358&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Misc Changes&lt;/h3&gt;
&lt;ul&gt;
&lt;li&gt;Turbopack: support turbopackIgnore on new URL(): &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;5786060324&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/99965&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/99965/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/99965&quot;&gt;#99965&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;turbo-tasks-backend: release unused capacity in task storage: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;6262904465&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/101344&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/101344/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/101344&quot;&gt;#101344&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;turbopack-ecmascript: store AstPathTrie nodes as parent and kind indices: &lt;a class=&quot;issue-link js-issue-link&quot; data-error-text=&quot;Failed to load title&quot; data-id=&quot;6267802827&quot; data-permission-text=&quot;Title is private&quot; data-url=&quot;https://github.com/vercel/next.js/issues/101370&quot; data-hovercard-type=&quot;pull_request&quot; data-hovercard-url=&quot;/vercel/next.js/pull/101370/hovercard&quot; href=&quot;https://github.com/vercel/next.js/pull/101370&quot;&gt;#101370&lt;/a&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;h3&gt;Credits&lt;/h3&gt;
&lt;p&gt;Huge thanks to &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/lukesandberg/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/lukesandberg&quot;&gt;@lukesandberg&lt;/a&gt; and &lt;a class=&quot;user-mention notranslate&quot; data-hovercard-type=&quot;user&quot; data-hovercard-url=&quot;/users/aurorascharff/hovercard&quot; data-octo-click=&quot;hovercard-link-click&quot; data-octo-dimensions=&quot;link_type:self&quot; href=&quot;https://github.com/aurorascharff&quot;&gt;@aurorascharff&lt;/a&gt; for helping!&lt;/p&gt;</content>
