{
  "name": "@watchdog/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/postgres.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings 0",
