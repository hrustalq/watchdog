  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
