{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "globalPassThroughEnv": [
    "WATCHDOG_*",
    "DATABASE_URL",
    "BETTER_AUTH_*",
    "SMTP_*",
    "GOOGLE_CLIENT_*",
    "GITHUB_CLIENT_*",
    "TELEGRAM_*",
    "OBSCURA_*",
    "EGRESS_ALLOWLIST",
    "GLITCHTIP_DSN"
  ],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:unit": {
      "dependsOn": ["transit"]
    },
    "test:integration": {
      "dependsOn": ["transit"]
    }
  }
}
