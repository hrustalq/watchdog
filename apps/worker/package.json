{
  "name": "@watchdog/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run --passWithNoTests .int.test.ts"
  },
  "dependencies": {
    "@watchdog/core": "workspace:*",
    "@watchdog/db": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
