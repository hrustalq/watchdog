{
  "name": "@watchdog/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests --exclude \"**/*.int.test.ts\"",
    "test:integration": "vitest run --passWithNoTests .int.test.ts"
  },
  "dependencies": {
    "@watchdog/core": "workspace:*",
    "@watchdog/db": "workspace:*",
    "pg-boss": "^12.38.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@watchdog/lint-config": "workspace:*",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
