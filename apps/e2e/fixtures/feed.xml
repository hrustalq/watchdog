    <item>
      <title>HypoPG 1.4.5 is out!</title>
      <link>https://www.postgresql.org/about/news/hypopg-145-is-out-3428/</link>
      <description>&lt;p&gt;I'm pleased to announce the release of the version 1.4.5 of HypoPG, an extension adding support for Hypothetical Indexes, compatible with PostgreSQL 9.2 and above.&lt;/p&gt;</description>
      <pubDate>{{now | dateModify "-144h" | date "Mon, 02 Jan 2006 15:04:05 -0700"}}</pubDate>
      <guid>https://www.postgresql.org/about/news/hypopg-145-is-out-3428/</guid>
    </item>
