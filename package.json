{
  "name": "watchdog",
  "version": "0.5.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:gate": "node scripts/test-gate.mjs",
    "smoke": "pnpm --filter @watchdog/e2e smoke",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "turbo": "^2.11.10"
  }
}
